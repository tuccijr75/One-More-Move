{
  "name": "one-more-move",
  "version": "0.1.0",
  "description": "A brutal, turn-based grid survival game.",
  "author": "Michael Robertucci",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "dev": "electron .",
    "sim": "node sim/sim.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.onemorem.one",
    "productName": "One More Move",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "desktop/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
