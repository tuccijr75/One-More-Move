{
  "name": "one-more-move",
  "version": "1.0.0",
  "description": "A tactical survival puzzle game where every move matters.",
  "author": "Michael Robertucci",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "cap:sync": "npx cap sync",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios"
  },
  "build": {
    "appId": "com.tucci.onemoremove",
    "productName": "One More Move",
    "files": [
      "app/**/*",
      "main.js",
      "preload.js"
    ],
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": "nsis",
      "icon": "app/assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "app/assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "app/assets/icon.png"
    }
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  }
}
